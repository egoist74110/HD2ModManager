<Window x:Class="HD2ModManager.Views.IasLibraryPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:HD2ModManager.Views"
        xmlns:vm="clr-namespace:HD2ModManager.ViewModels"
        Title="从库里选 Mod 转 IAS" Width="620" MinWidth="620" MaxWidth="620" Height="640" MinHeight="460"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceCard}" UseLayoutRounding="True" SnapsToDevicePixels="True"
        PreviewKeyDown="OnPreviewKeyDown">
    <!--
        「从库里选 Mod 转 IAS」：搜索 + 分段筛选 + 两组卡片网格（多选）+ 底栏已选摘要。
        颜色全部取自 Themes/Controls.xaml；只有来源胶囊和选中底色是这个对话框自己的。
        DataContext 是 IasLibraryPickerViewModel。
    -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="5" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <local:ImagePlaceholderConverter x:Key="CoverImage"/>
        <local:EnumEqualsConverter x:Key="EnumEquals"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <SolidColorBrush x:Key="SelectedCardFill" Color="#F3F7FF"/>
        <SolidColorBrush x:Key="PillStandardBack" Color="#E6EFFD"/>
        <SolidColorBrush x:Key="PillStandardText" Color="#174FA8"/>
        <SolidColorBrush x:Key="PillVpkBack" Color="#DCF2F0"/>
        <SolidColorBrush x:Key="PillVpkText" Color="#0E6762"/>
        <SolidColorBrush x:Key="PillBodyBack" Color="#EEE6FA"/>
        <SolidColorBrush x:Key="PillBodyText" Color="#5A32A3"/>
        <SolidColorBrush x:Key="PillWarnBack" Color="#FFF1CC"/>
        <SolidColorBrush x:Key="PillWarnText" Color="#8A5A00"/>

        <Style x:Key="SegmentButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Box" CornerRadius="6" BorderThickness="1" BorderBrush="Transparent"
                                Background="Transparent" Height="28" Margin="1,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource SurfaceCard}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource StrokeControl}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SourcePill" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="7,1"/>
            <Setter Property="Background" Value="{StaticResource PillStandardBack}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source}" Value="L4d2Vpk">
                    <Setter Property="Background" Value="{StaticResource PillVpkBack}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Source}" Value="CustomModel">
                    <Setter Property="Background" Value="{StaticResource PillBodyBack}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SourcePillText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource PillStandardText}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source}" Value="L4d2Vpk">
                    <Setter Property="Foreground" Value="{StaticResource PillVpkText}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Source}" Value="CustomModel">
                    <Setter Property="Foreground" Value="{StaticResource PillBodyText}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 卡片外框：悬停加深并微灰；选中 2px 蓝框 + 淡蓝底（内边距少 1px，内容不跳动）；不可转灰底。 -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceCard}"/>
            <Setter Property="BorderBrush" Value="{StaticResource StrokeSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource StrokeControl}"/>
                    <Setter Property="Background" Value="{StaticResource SurfaceRowHover}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource StrokeFocus}"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                    <Setter Property="Padding" Value="8"/>
                    <Setter Property="Background" Value="{StaticResource SelectedCardFill}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsConvertible}" Value="False">
                    <Setter Property="Background" Value="{StaticResource SurfaceMuted}"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="CardTemplate" DataType="{x:Type vm:IasLibraryPickerItem}">
            <Border x:Name="Card" Style="{StaticResource CardBorder}" Margin="5" ToolTip="{Binding ToolTipText}"
                    MouseLeftButtonUp="OnCardClicked" AutomationProperties.Name="{Binding Name}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="56" Height="72" CornerRadius="7" Background="{StaticResource SurfaceMuted}" VerticalAlignment="Top">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConvertible}" Value="False">
                                        <Setter Property="Opacity" Value="0.5"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Image Stretch="UniformToFill" Width="56" Height="72"
                               Source="{Binding ThumbnailPath, Converter={StaticResource CoverImage}, ConverterParameter=112}">
                            <Image.Clip>
                                <RectangleGeometry Rect="0,0,56,72" RadiusX="7" RadiusY="7"/>
                            </Image.Clip>
                        </Image>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Top">
                        <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis" LineHeight="18" LineStackingStrategy="BlockLineHeight"
                                   MaxHeight="36" Margin="0,0,24,0" Foreground="{StaticResource TextPrimary}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConvertible}" Value="False">
                                            <Setter Property="Opacity" Value="0.5"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding MetaText}" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource TextSecondary}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasMeta}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <WrapPanel Margin="0,6,0,0" Orientation="Horizontal">
                            <Border Style="{StaticResource SourcePill}" Margin="0,0,6,2">
                                <TextBlock Text="{Binding SourceText}" Style="{StaticResource SourcePillText}"/>
                            </Border>
                            <Border CornerRadius="8" Padding="7,1" Background="{StaticResource PillWarnBack}" Margin="0,0,6,2"
                                    VerticalAlignment="Center" ToolTip="{Binding UnavailableReason}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConvertible}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding UnavailableReason}" FontSize="11" Foreground="{StaticResource PillWarnText}"
                                           TextWrapping="Wrap"/>
                            </Border>
                            <TextBlock Text="{Binding Number}" FontSize="11" Foreground="{StaticResource TextTertiary}"
                                       VerticalAlignment="Center" Margin="0,0,0,2" Opacity="0.8">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasNumber}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </WrapPanel>
                    </StackPanel>
                    <!-- 右上角 20px 勾选圈：不可转的卡片不显示。 -->
                    <Grid Grid.Column="1" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top"
                          Visibility="{Binding IsConvertible, Converter={StaticResource BoolToVisibility}}">
                        <Ellipse x:Name="Ring" Stroke="{StaticResource StrokeControl}" StrokeThickness="1.5" Fill="{StaticResource SurfaceCard}"/>
                        <Ellipse x:Name="Dot" Fill="{StaticResource Accent}" Visibility="Collapsed"/>
                        <Path x:Name="Tick" Visibility="Collapsed" Data="M5.5,10.3 L8.6,13.2 L14.6,6.8" Stroke="White" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Grid>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="CardGrid" TargetType="ItemsControl">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="ItemTemplate" Value="{StaticResource CardTemplate}"/>
            <Setter Property="Margin" Value="13,0,13,4"/>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2"/>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GroupHeader" TargetType="Grid">
            <Setter Property="Margin" Value="18,6,18,6"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource StrokeControl}" BorderThickness="1" Background="{StaticResource SurfaceCard}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题区 -->
            <Grid Grid.Row="0" Margin="18,16,12,12" MouseLeftButtonDown="OnTitleMouseDown" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="从库里选 Mod 转 IAS" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock Text="可以多选，转完一起装进 IAS" FontSize="13" Margin="0,3,0,0" Foreground="{StaticResource TextSecondary}"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource AppIconButton}" VerticalAlignment="Top" Click="OnClose"
                        AutomationProperties.Name="关闭" ToolTip="关闭">
                    <Path Width="11" Height="11" Data="M1,1 L10,10 M10,1 L1,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Button>
            </Grid>

            <!-- 搜索框 -->
            <Border Grid.Row="1" Margin="18,0,18,10" Height="34" CornerRadius="8" BorderThickness="1"
                    BorderBrush="{StaticResource StrokeControl}" Background="{StaticResource SurfaceCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Path Margin="11,0,0,0" Width="14" Height="14" VerticalAlignment="Center" Stretch="Uniform"
                          Data="M5.5,1 A4.5,4.5 0 1 0 5.5,10 A4.5,4.5 0 1 0 5.5,1 M9,9 L12.5,12.5"
                          Stroke="{StaticResource TextSecondary}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <TextBlock Grid.Column="1" Text="搜索名字或编号" Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                               Foreground="{StaticResource TextTertiary}" FontSize="13">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBox x:Name="SearchBox" Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="6,0" Margin="3,0,0,0"
                             VerticalContentAlignment="Center" VerticalAlignment="Center" FontSize="13"
                             Foreground="{StaticResource TextPrimary}" AutomationProperties.Name="搜索名字或编号"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
            </Border>

            <!-- 分段筛选 -->
            <Border Grid.Row="2" Margin="18,0,18,12" Padding="2" CornerRadius="8" Background="#EDEFF3">
                <UniformGrid Columns="5">
                    <RadioButton Content="全部" GroupName="LibraryFilter" Style="{StaticResource SegmentButton}"
                                 IsChecked="{Binding Filter, Mode=TwoWay, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:IasLibraryFilter.All}}"/>
                    <RadioButton Content="当前配置" GroupName="LibraryFilter" Style="{StaticResource SegmentButton}"
                                 IsChecked="{Binding Filter, Mode=TwoWay, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:IasLibraryFilter.Current}}"/>
                    <RadioButton Content="普通 Mod" GroupName="LibraryFilter" Style="{StaticResource SegmentButton}"
                                 IsChecked="{Binding Filter, Mode=TwoWay, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:IasLibraryFilter.Standard}}"/>
                    <RadioButton Content="求生 VPK" GroupName="LibraryFilter" Style="{StaticResource SegmentButton}"
                                 IsChecked="{Binding Filter, Mode=TwoWay, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:IasLibraryFilter.Vpk}}"/>
                    <RadioButton Content="素体" GroupName="LibraryFilter" Style="{StaticResource SegmentButton}"
                                 IsChecked="{Binding Filter, Mode=TwoWay, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:IasLibraryFilter.Body}}"/>
                </UniformGrid>
            </Border>

            <!-- 列表区 -->
            <Grid Grid.Row="3">
                <ScrollViewer x:Name="ListScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding ShowList, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Margin="0,0,0,8">
                        <Grid Style="{StaticResource GroupHeader}" Visibility="{Binding HasCurrent, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Stroke="{StaticResource StatusSuccess}"
                                  StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M8,1 A7,7 0 1 0 8,15 A7,7 0 1 0 8,1 M5,8.3 L7.2,10.5 L11,5.8"/>
                            <TextBlock Grid.Column="1" Text="当前配置里的" FontSize="13" FontWeight="SemiBold" Margin="7,0,0,0"
                                       Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding CurrentCountText}" FontSize="12" Margin="6,0,10,0"
                                       Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center"/>
                            <Rectangle Grid.Column="3" Height="1" Fill="{StaticResource StrokeSubtle}" VerticalAlignment="Center"/>
                        </Grid>
                        <ItemsControl Style="{StaticResource CardGrid}" ItemsSource="{Binding CurrentItems}" x:Name="CurrentList"/>

                        <Grid Style="{StaticResource GroupHeader}" Visibility="{Binding HasOther, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Stroke="{StaticResource TextSecondary}"
                                  StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M1.5,2.5 L6.8,2.5 Q8,2.5 8,3.7 L8,13.5 Q8,12.3 6.8,12.3 L1.5,12.3 Z M14.5,2.5 L9.2,2.5 Q8,2.5 8,3.7 L8,13.5 Q8,12.3 9.2,12.3 L14.5,12.3 Z"/>
                            <TextBlock Grid.Column="1" Text="库里其他的" FontSize="13" FontWeight="SemiBold" Margin="7,0,0,0"
                                       Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding OtherCountText}" FontSize="12" Margin="6,0,10,0"
                                       Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center"/>
                            <Rectangle Grid.Column="3" Height="1" Fill="{StaticResource StrokeSubtle}" VerticalAlignment="Center"/>
                        </Grid>
                        <ItemsControl Style="{StaticResource CardGrid}" ItemsSource="{Binding OtherItems}" x:Name="OtherList"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- 加载中 -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <ProgressBar IsIndeterminate="True" Width="160" Height="4" Foreground="{StaticResource Accent}"/>
                    <TextBlock Text="正在读取 Mod 库…" Margin="0,12,0,0" HorizontalAlignment="Center" Foreground="{StaticResource TextSecondary}" FontSize="13"/>
                </StackPanel>

                <!-- 读取失败 -->
                <TextBlock Text="{Binding LoadError}" TextWrapping="Wrap" TextAlignment="Center" Margin="40,0" MaxWidth="460"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource StatusDanger}" FontSize="13"
                           Visibility="{Binding HasLoadError, Converter={StaticResource BoolToVisibility}}"/>

                <!-- 空状态 -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                    <Path Width="34" Height="34" Stretch="Uniform" HorizontalAlignment="Center"
                          Data="M5.5,1 A4.5,4.5 0 1 0 5.5,10 A4.5,4.5 0 1 0 5.5,1 M9,9 L12.5,12.5"
                          Stroke="{StaticResource StrokeControl}" StrokeThickness="1.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <TextBlock Text="没找到，换个关键词试试" Margin="0,12,0,0" Foreground="{StaticResource TextSecondary}" FontSize="13"/>
                </StackPanel>
            </Grid>

            <!-- 底栏 -->
            <Border Grid.Row="4" BorderBrush="{StaticResource StrokeSubtle}" BorderThickness="0,1,0,0" Background="{StaticResource SurfaceMuted}"
                    Padding="18,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ItemsControl ItemsSource="{Binding Avatars}" VerticalAlignment="Center" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="26" Height="26" CornerRadius="13" Margin="0,0,-8,0" BorderThickness="2"
                                        BorderBrush="{StaticResource SurfaceMuted}" ToolTip="{Binding Name}">
                                    <Ellipse>
                                        <Ellipse.Fill>
                                            <ImageBrush Stretch="UniformToFill"
                                                        ImageSource="{Binding ThumbnailPath, Converter={StaticResource CoverImage}, ConverterParameter=52}"/>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Grid.Column="1" Text="{Binding SummaryText}" FontSize="13" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondary}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Margin" Value="0"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanConfirm}" Value="True">
                                        <Setter Property="Margin" Value="18,0,0,0"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="取消" Style="{StaticResource AppSecondaryButton}" MinWidth="72" IsCancel="True"/>
                        <Button x:Name="ConfirmButton" Content="{Binding ConfirmText}" Style="{StaticResource AppPrimaryButton}" MinWidth="120"
                                Margin="8,0,0,0" IsDefault="True" IsEnabled="{Binding CanConfirm}" Click="OnConfirm"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
